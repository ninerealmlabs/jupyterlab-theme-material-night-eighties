{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "root": true,

  "files": {
    "includes": [
      "**/*.{js,ts,jsx,tsx,json,jsonc,css}",
      "!!**/node_modules",
      "!!**/lib",
      "!!**/dist",
      "!!**/build",
      // Generated by `jupyter-builder`; not source.
      "!!jupyterlab_material_night_eighties/labextension"
    ],
    "ignoreUnknown": true
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // Transferred from eslint.config.mjs. eslint now carries only the
      // @jupyter/eslint-plugin rules, which are JupyterLab-specific and have
      // no biome equivalent.
      "style": {
        // was `curly: ["error", "all"]`
        "useBlockStatements": "error",
        // was `@typescript-eslint/no-namespace: "off"`
        "noNamespace": "off",
        // was `@typescript-eslint/naming-convention`: interfaces must be
        // PascalCase and prefixed with I, a JupyterLab convention.
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "interface" },
                "match": "I[A-Z].*"
              }
            ]
          }
        }
      },
      "suspicious": {
        // was `@typescript-eslint/no-explicit-any: "off"`
        "noExplicitAny": "off"
      },
      "correctness": {
        // was `@typescript-eslint/no-unused-vars: ["warn", { args: "none" }]`,
        // so parameters are deliberately not reported.
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "off",
        // was `@typescript-eslint/no-use-before-define: "off"`
        "noInvalidUseBeforeDeclaration": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": true,
    "expand": "auto"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "preserve",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },

  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },

  "css": {
    "parser": {
      "cssModules": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },

  "overrides": [
    {
      // The JupyterLab extension template indents package.json with four
      // spaces, and prettier was configured to leave it alone. Reindenting it
      // would rewrite the whole file for no benefit and make future diffs
      // against the upstream template harder to read.
      "includes": ["package.json"],
      "formatter": {
        "indentWidth": 4
      }
    }
  ]
}
